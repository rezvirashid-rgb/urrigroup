# =====================================================================
#  URRI GROUP — Apache / LiteSpeed configuration (cPanel / shared hosting)
#  Every module-specific block is wrapped in <IfModule>, so a host that
#  disables a module still serves the site instead of a 500 error.
# =====================================================================

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One address per page: /index.html -> /   (avoids duplicate URLs in Google)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Uncomment ONE of these to force a single host name:
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Internal folders are never served directly.
  RewriteRule ^(config|forms/lib)(/|$) - [F,L]
</IfModule>

# ---- Never serve these, wherever they are ----------------------------
<FilesMatch "^\.|^config\.php$|\.(md|sql|log|ini|sh|bak|dist)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---- Types -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# ---- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml \
    application/manifest+json image/x-icon
</IfModule>

# ---- Browser caching -------------------------------------------------
# CSS/JS links carry a ?v= version, so they can be cached for a year and
# still update instantly after a rebuild.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                         "access plus 1 week"
  ExpiresByType text/html                "access plus 0 seconds"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 month"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/x-icon             "access plus 1 month"
</IfModule>

# ---- Security headers ------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Once HTTPS has worked reliably for a while, you may enable HSTS:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
