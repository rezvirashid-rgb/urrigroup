# =====================================================================
#  URRI GROUP — Apache configuration (cPanel / shared hosting)
#  Safe defaults. If your host disables a module, wrap-guards below
#  keep the site working rather than throwing a 500 error.
# =====================================================================

# ---- Default documents ----------------------------------------------
DirectoryIndex index.html index.php

# ---- Custom error page ----------------------------------------------
ErrorDocument 404 /404.html

# ---- Force HTTPS + optional www canonicalisation --------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prefer non-www (uncomment to force the bare domain)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Protect sensitive files ----------------------------------------
# Block direct access to the PHP config (defence in depth).
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
# Hide dotfiles (.git, .htaccess, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block browsing of the config directory entirely.
RedirectMatch 403 ^/config/.*$

# ---- Disable directory listing --------------------------------------
Options -Indexes

# ---- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Browser caching -------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ---- Security headers ------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Remove caching for the config example if ever requested
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ---- UTF-8 default ---------------------------------------------------
AddDefaultCharset UTF-8
